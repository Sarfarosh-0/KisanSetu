# ============================================================
# KisanSetu Backend — Environment Variables Template
# ============================================================
# HOW TO USE:
#   1. Copy this file:  copy .env.example backend\.env   (Windows)
#   2. Fill in your real values below
#   3. NEVER commit backend\.env to Git — it is already in .gitignore
# ============================================================

# --- Cloudinary (Persistent Image Storage) ---
# Get this from: https://cloudinary.com → Dashboard → "API Environment variable"
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Leave blank to use local disk storage (development only)
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME

# --- PostgreSQL Database (Production) ---
# Get this from: Neon / Supabase / Render PostgreSQL dashboard
# Format: postgresql://user:password@host:5432/dbname
# Leave blank to use SQLite locally (auto-created as kisansetu.db)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- App Settings ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
APP_URL=http://localhost:3000
